# Porta da aplicação no host
PORT=3000

# Endereço do Postgres. Dentro do Compose use o nome do serviço.
# DB_HOST=localhost é intencional (erro didático do Hands-on 3) — no
# docker-compose o valor do .env abaixo (postgres) sobrescreve o padrão.
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=oficina

# Redis — dentro do Compose use o nome do serviço.
# Vazio (REDIS_HOST=) desativa o contador de visitas; a app sobe do mesmo jeito.
REDIS_HOST=redis
REDIS_PORT=6379
